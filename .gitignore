.venv/
venv/

# PlatformIO / ESP-IDF / Firmware (futuro)
.pio/
build/
sdkconfig.old

# IDEs & Sistema Operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
